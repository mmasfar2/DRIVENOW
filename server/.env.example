PORT=4000
SESSION_SECRET=change-this-to-a-long-random-string
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-password
PUBLIC_SITE_ORIGIN=https://your-username.github.io
NODE_ENV=production
# Optional — email invoices straight from the portal through your Gmail.
# EMAIL_APP_PASSWORD is a Gmail "app password" (Google Account > Security >
# 2-Step Verification > App passwords), not your normal Gmail password.
# Leave blank to have Send by Email open a Gmail compose window instead.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=QueenCity Auto-Rentals
